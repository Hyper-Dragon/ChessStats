<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- Release number: ChessDotComApi.Version reads this, so bump it here only. -->
    <Version>0.8.3</Version>
    <AssemblyVersion>0.8.3.0</AssemblyVersion>
    <FileVersion>0.8.3.0</FileVersion>
    <Product>ChessStats</Product>
    <Company>Hyper-Dragon</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Release artifacts ship without debug symbols (the referenced library's pdb included). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\FavIcon.png" />
    <None Remove="Images\SeamlessBkg01.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images\FavIcon.png" />
    <EmbeddedResource Include="Images\SeamlessBkg01.png" />
    <EmbeddedResource Include="Images\DefaultAvatar.png" />
    <EmbeddedResource Include="Images\HeadingIcon.png" />
    <EmbeddedResource Include="Images\Montserrat-700.woff2" />
    <EmbeddedResource Include="Images\Montserrat-800.woff2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="VectSharp" Version="2.3.0" />
    <PackageReference Include="VectSharp.SVG" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ChessDotComSharp\ChessDotComSharp\ChessDotComSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\PublishProfiles\" />
  </ItemGroup>

  <!--
    AllowedReferenceRelatedFileExtensions does not cover project references, so the referenced
    library's pdb still lands next to the published binary. Drop every pdb from Release publishes.
  -->
  <Target Name="StripPdbFromReleasePublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.pdb'))" />
    </ItemGroup>
  </Target>

</Project>
